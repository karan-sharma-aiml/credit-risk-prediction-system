# Copy to .env and edit. Never commit .env.

# --- Application -------------------------------------------------------------
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
LOG_JSON=true                      # structured JSON logs (false = human-readable)
API_HOST=0.0.0.0
API_PORT=8000
# Used to pseudonymise customer IDs in logs (HMAC). REQUIRED to be changed in production.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:8501  # comma-separated list

# --- Model -------------------------------------------------------------------
MODEL_PATH=saved_models/model_bundle.joblib

# --- Database ----------------------------------------------------------------
# Local dev without Postgres:   sqlite:///./credit_risk.db
# Postgres (Docker Compose uses the host name "db"):
DATABASE_URL=postgresql://credit_risk:CHANGE_ME@localhost:5432/credit_risk
AUTO_CREATE_TABLES=true            # create tables on startup (idempotent)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --- Docker Compose only (PostgreSQL container) -------------------------------
POSTGRES_USER=credit_risk
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=credit_risk

# --- Streamlit dashboard -----------------------------------------------------
API_URL=http://localhost:8000      # where the dashboard finds the API
